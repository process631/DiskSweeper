<Window x:Class="DiskSweeper.App.Views.ConfirmProgramRemovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove program" Icon="pack://application:,,,/DiskSweeper;component/Assets/DiskSweeper.ico"
        Width="760" Height="720" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="28,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Top" IsChecked="{Binding ExtraConfirmed}" Margin="0,0,0,14"
                          Visibility="{Binding NeedsExtraConfirmation, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ExtraConfirmationText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </CheckBox>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" MinWidth="170" Click="Confirm_Click" />
                    <Button Style="{StaticResource StandardButton}" Content="Cancel" MinWidth="100" Margin="8,0,0,0" IsCancel="True" IsDefault="True" />
                </StackPanel>
                <CheckBox IsChecked="{Binding DryRun}" VerticalAlignment="Center"
                          ToolTip="Shows what would happen and writes it to the history, without deleting anything or running the uninstaller.">
                    <TextBlock Text="Preview only (dry run)" />
                </CheckBox>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,20">
                <DockPanel>
                    <Border Style="{StaticResource IconTile}" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Text="&#xE74D;" HorizontalAlignment="Center" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Heading}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource NoticeBar}" Margin="0,18,0,0">
                    <TextBlock Text="{Binding UninstallText}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding CommandText}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisibility}}" />

                <Border Style="{StaticResource NoticeBar}" Tag="Caution" Margin="0,12,0,0" Visibility="{Binding HasRunning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding RunningText}" TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding CloseFirst}" Margin="0,8,0,0" Content="Close them first" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource NoticeBar}" Margin="0,12,0,0" Visibility="{Binding ShowAdminNote, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap" Text="Windows may ask for administrator permission. The uninstaller asks for itself, and registry keys under HKLM are removed by a short elevated helper." />
                </Border>

                <TextBlock Text="How should the files be removed?" Style="{StaticResource Strong}" Margin="0,20,0,10"
                           Visibility="{Binding DryRun, Converter={StaticResource InverseBoolToVisibility}}" />
                <Grid Visibility="{Binding DryRun, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Style="{StaticResource OptionCard}" GroupName="Method" IsChecked="{Binding UseRecycleBin}">
                        <StackPanel>
                            <TextBlock Text="Move files to the Recycle Bin" Style="{StaticResource Strong}" />
                            <TextBlock Text="You can restore them later. Registry keys are still removed for good." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="2" Style="{StaticResource OptionCard}" GroupName="Method" IsChecked="{Binding UsePermanent}">
                        <StackPanel>
                            <TextBlock Text="Delete files permanently" Style="{StaticResource Strong}" />
                            <TextBlock Text="Frees the space right away. Can't be undone." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <TextBlock Text="What will be removed" Style="{StaticResource Strong}" Margin="0,20,0,10" />
                <Border Style="{StaticResource Card}" Padding="4">
                    <ItemsControl ItemsSource="{Binding Chosen}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" />
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="Nothing else was ticked. Only the uninstaller will run." Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Chosen.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
