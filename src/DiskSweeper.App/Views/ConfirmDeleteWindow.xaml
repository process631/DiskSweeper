<Window x:Class="DiskSweeper.App.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm delete" Icon="pack://application:,,,/DiskSweeper;component/Assets/DiskSweeper.ico"
        Width="780" Height="720" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="28,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <!-- Extra confirmation for big or permanent deletes, right above the button it unlocks -->
                <CheckBox DockPanel.Dock="Top" IsChecked="{Binding ExtraConfirmed}" Margin="0,0,0,14"
                          Visibility="{Binding NeedsExtraConfirmation, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ExtraConfirmationText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </CheckBox>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" MinWidth="170" Click="Confirm_Click" />
                    <Button Style="{StaticResource StandardButton}" Content="Cancel" MinWidth="100" Margin="8,0,0,0" IsCancel="True" IsDefault="True" />
                </StackPanel>
                <CheckBox IsChecked="{Binding DryRun}" VerticalAlignment="Center"
                          ToolTip="Shows what would happen and writes it to the history, without deleting anything.">
                    <TextBlock Text="Preview only (dry run)" />
                </CheckBox>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,20">
                <!-- Heading -->
                <DockPanel>
                    <Border Style="{StaticResource IconTile}" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Text="&#xE74D;" HorizontalAlignment="Center" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0">
                            <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TotalText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Method -->
                <TextBlock Text="How should they be removed?" Style="{StaticResource Strong}" Margin="0,24,0,10"
                           Visibility="{Binding DryRun, Converter={StaticResource InverseBoolToVisibility}}" />
                <Grid Visibility="{Binding DryRun, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Style="{StaticResource OptionCard}" GroupName="Method" IsChecked="{Binding UseRecycleBin}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE74D;" VerticalAlignment="Top" Margin="0,2,12,0" />
                            <StackPanel>
                                <TextBlock Text="Move to Recycle Bin" Style="{StaticResource Strong}" />
                                <TextBlock Text="You can restore them later. The space is freed when you empty the bin." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="2" Style="{StaticResource OptionCard}" GroupName="Method" IsChecked="{Binding UsePermanent}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xEA99;" VerticalAlignment="Top" Margin="0,2,12,0" />
                            <StackPanel>
                                <TextBlock Text="Delete permanently" Style="{StaticResource Strong}" />
                                <TextBlock Text="Frees the space right away and handles long or odd paths. Can't be undone." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                </Grid>
                <Border Style="{StaticResource NoticeBar}" Margin="0,16,0,0" Visibility="{Binding DryRun, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Preview only: nothing will be deleted. You'll see what would happen, and the preview is written to the history." TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource NoticeBar}" Tag="Caution" Margin="0,12,0,0"
                        Visibility="{Binding ShowCantRecycleWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding CantRecycleText}" TextWrapping="Wrap" />
                </Border>

                <!-- Items -->
                <TextBlock Text="What will be removed" Style="{StaticResource Strong}" Margin="0,24,0,10" />
                <Border Style="{StaticResource Card}" Padding="4">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,2,0,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" />
                                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,4,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2,0,0">
                                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,6,0"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Protected -->
                <Border Style="{StaticResource NoticeBar}" Tag="Caution" Margin="0,16,0,0" Visibility="{Binding HasRefused, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE72E;" Margin="0,0,8,0" />
                            <TextBlock Text="These are protected and will be skipped" Style="{StaticResource Strong}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Refused}" Margin="22,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="{Binding Path, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " />
                                        <Run Text="{Binding Refusal, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
