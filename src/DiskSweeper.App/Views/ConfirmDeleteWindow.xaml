<Window x:Class="DiskSweeper.App.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm delete" Width="760" Height="620" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding MethodText}" TextWrapping="Wrap" Margin="0,6,0,14" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Visibility="{Binding HasRefused, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                <TextBlock Text="These are protected and will be skipped:" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Refused}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                <Run Text="•" /> <Run Text="{Binding Path, Mode=OneWay}" /> <Run Text="—" Foreground="Gray" />
                                <Run Text="{Binding Refusal, Mode=OneWay}" Foreground="Gray" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <CheckBox x:Name="ExtraConfirm" Content="{Binding ExtraConfirmationText}" Margin="0,0,0,12"
                      Visibility="{Binding NeedsExtraConfirmation, Converter={StaticResource BoolToVisibility}}"
                      Checked="ExtraConfirm_Changed" Unchecked="ExtraConfirm_Changed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ConfirmButton" MinWidth="120" Click="Confirm_Click" Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" MinWidth="100" Margin="8,0,0,0" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </StackPanel>

        <ListBox ItemsSource="{Binding ToDelete}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}" Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding WarningText}" Style="{StaticResource Warning}" Margin="0,2,0,0"
                                       Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="12,0,4,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
