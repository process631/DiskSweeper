<Window x:Class="DiskSweeper.App.Views.DeleteResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup results" Icon="pack://application:,,,/DiskSweeper;component/Assets/DiskSweeper.ico"
        Width="820" Height="640" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="28,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Done" MinWidth="110" IsCancel="True" IsDefault="True" />
                <ProgressBar IsIndeterminate="True" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <!-- Headline -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16">
            <Border Width="48" Height="48" CornerRadius="24">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllGood}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding HeadlineGlyph}" FontSize="22" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllGood}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Padding="4" Margin="28,0,28,20" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllSucceeded}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Warning}" Margin="0,4,0,0"
                                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Style="{StaticResource StandardButton}" Content="{Binding CloseAppsText}" Margin="0,0,8,6"
                                                Visibility="{Binding CanCloseApps, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.CloseAppsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource StandardButton}" Margin="0,0,8,6" Visibility="{Binding CanTakeOwnership, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.TakeOwnershipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                ToolTip="Makes you the owner with full control, then deletes. Fixes leftovers owned by TrustedInstaller, SYSTEM or old accounts.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xEA18;" Margin="0,0,8,0"
                                                           Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="Take ownership and delete" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource StandardButton}" Margin="0,0,8,6" Visibility="{Binding CanRestartDelete, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RestartDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                ToolTip="Windows deletes it early in the next startup, before anything can lock it.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xEA18;" Margin="0,0,8,0"
                                                           Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="Delete on next restart" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource StandardButton}" Content="Delete permanently instead" Margin="0,0,8,6"
                                                Visibility="{Binding CanDeletePermanently, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.DeletePermanentlyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Show in Explorer" Margin="0,0,8,6"
                                                Visibility="{Binding AllSucceeded, Converter={StaticResource InverseBoolToVisibility}}"
                                                Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
