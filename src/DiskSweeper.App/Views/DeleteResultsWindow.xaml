<Window x:Class="DiskSweeper.App.Views.DeleteResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete results" Width="820" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Results" FontSize="20" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,12" />
        <ProgressBar DockPanel.Dock="Top" Height="4" IsIndeterminate="True" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" MinWidth="100" IsCancel="True" IsDefault="True" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}" Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource Warning}" Margin="0,2,0,0"
                                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="{Binding CloseAppsText}" Margin="0,0,6,6"
                                        Visibility="{Binding CanCloseApps, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.CloseAppsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                <Button Margin="0,0,6,6" Visibility="{Binding CanTakeOwnership, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.TakeOwnershipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        ToolTip="Makes you the owner with full control, then deletes. Fixes leftovers owned by TrustedInstaller, SYSTEM or old accounts.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,6,0"
                                                   Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="Take ownership and delete" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,6" Visibility="{Binding CanRestartDelete, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.RestartDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        ToolTip="Windows deletes it early in the next startup, before anything can lock it.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,6,0"
                                                   Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="Delete on next restart" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Delete permanently instead" Margin="0,0,6,6"
                                        Visibility="{Binding CanDeletePermanently, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.DeletePermanentlyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                <Button Content="Show in Explorer" Margin="0,0,6,6"
                                        Visibility="{Binding AllSucceeded, Converter={StaticResource InverseBoolToVisibility}}"
                                        Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
