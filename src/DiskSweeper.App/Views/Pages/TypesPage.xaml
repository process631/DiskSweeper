<UserControl x:Class="DiskSweeper.App.Views.Pages.TypesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NoScanState}"
                        Visibility="{Binding HasScan, Converter={StaticResource InverseBoolToVisibility}}" />

        <Grid Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="16,16,16,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="By kind" Style="{StaticResource SectionTitle}" Margin="4,0,0,10" />
                    <DataGrid Style="{StaticResource AppGrid}" ItemsSource="{Binding FileTypes.Kinds}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Kind" SortMemberPath="Kind" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="4,0,10,0" />
                                            <TextBlock Text="{Binding KindName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="90" ElementStyle="{StaticResource NumberCell}" FontWeight="SemiBold" />
                            <DataGridTemplateColumn Header="" Width="*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Height="8" CornerRadius="4" Width="{Binding BarWidth}"
                                                Background="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Files" Binding="{Binding Count, StringFormat=N0}" SortMemberPath="Count" Width="90" ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,16,16,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="Double-click to list those files" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="By extension" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <DataGrid x:Name="ExtensionGrid" Style="{StaticResource AppGrid}" ItemsSource="{Binding FileTypes.Extensions}"
                              MouseDoubleClick="ExtensionGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="120" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="Kind" SortMemberPath="Kind" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding KindName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="90" ElementStyle="{StaticResource NumberCell}" FontWeight="SemiBold" />
                            <DataGridTemplateColumn Header="" Width="*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Height="8" CornerRadius="4" Width="{Binding BarWidth}"
                                                Background="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Files" Binding="{Binding Count, StringFormat=N0}" SortMemberPath="Count" Width="90" ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
