<UserControl x:Class="DiskSweeper.App.Views.Pages.TreemapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DiskSweeper.App.Views">
    <Grid>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NoScanState}"
                        Visibility="{Binding HasScan, Converter={StaticResource InverseBoolToVisibility}}" />

        <DockPanel Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
            <views:DetailsPanel DockPanel.Dock="Right" Margin="16,0,0,0" />

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Left" Style="{StaticResource StandardButton}" Command="{Binding TreemapUpCommand}" Padding="10,6" ToolTip="Up one folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74A;" Margin="0,0,6,0" />
                        <TextBlock Text="Up" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Treemap.Breadcrumb}" Style="{StaticResource Strong}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>

            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding FileTypes.Kinds}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding KindName}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Treemap.HoverText}" Style="{StaticResource Secondary}" Margin="2,10,0,0" />

            <Border Style="{StaticResource Card}" Padding="3" ClipToBounds="True">
                <views:TreemapView Root="{Binding Treemap.Root}" Version="{Binding Treemap.Version}"
                                   HoveredNode="{Binding Treemap.HoveredNode, Mode=OneWayToSource}"
                                   NodeActivated="Treemap_NodeActivated" NodeClicked="Treemap_NodeClicked"
                                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <views:TreemapView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Select or unselect for cleanup" Command="{Binding ToggleSelectCommand}"
                                      CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="Open in File Explorer" Command="{Binding ShowInExplorerCommand}"
                                      CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Show in Folders" Command="{Binding ShowInFoldersCommand}"
                                      CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Zoom into this" Command="{Binding ShowInTreemapCommand}"
                                      CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}"
                                      CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </views:TreemapView.ContextMenu>
                </views:TreemapView>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
