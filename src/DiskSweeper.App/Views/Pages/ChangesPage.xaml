<UserControl x:Class="DiskSweeper.App.Views.Pages.ChangesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NoScanState}"
                        Visibility="{Binding HasScan, Converter={StaticResource InverseBoolToVisibility}}" />

        <DockPanel Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Compare with the scan from" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Width="400" ItemsSource="{Binding Changes.SavedScans}" SelectedItem="{Binding Changes.Selected}" />
                        <Button Style="{StaticResource StandardButton}" Content="Compare" Margin="8,0,0,0" Command="{Binding Changes.CompareCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Changes.Summary}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="4">
                <DataGrid Style="{StaticResource AppGrid}" ItemsSource="{Binding Changes.Rows}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Change" SortMemberPath="Delta" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Change}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Grew">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="New">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="What" Binding="{Binding Kind}" Width="80" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Now" Binding="{Binding After}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
