<UserControl x:Class="DiskSweeper.App.Views.Pages.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DiskSweeper.App.Views">
    <Grid>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NoScanState}"
                        Visibility="{Binding HasScan, Converter={StaticResource InverseBoolToVisibility}}" />

        <DockPanel Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
            <views:DetailsPanel DockPanel.Dock="Right" Margin="16,0,0,0" />

            <!-- Filters -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                <WrapPanel>
                        <Grid Width="220" Margin="0,0,12,0">
                            <TextBox Text="{Binding BiggestFiles.Search, UpdateSourceTrigger=PropertyChanged, Delay=350}" Padding="34,6,8,6"
                                     ToolTip="Part of a name, or an extension such as .iso" />
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE721;" Margin="12,0,0,0" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <TextBlock Text="At least" VerticalAlignment="Center" Style="{StaticResource Secondary}" Margin="0,0,8,0" />
                            <TextBox Width="90" Text="{Binding BiggestFiles.MinimumSize, UpdateSourceTrigger=PropertyChanged, Delay=400}" ToolTip="For example 500 MB or 2 GB" />
                        </StackPanel>
                        <ComboBox Width="200" Margin="0,0,12,0" ItemsSource="{Binding BiggestFiles.AgeChoices}" DisplayMemberPath="Value"
                                  SelectedValuePath="Key" SelectedValue="{Binding BiggestFiles.OlderThanDays}" />
                        <ComboBox Width="140" Margin="0,0,16,0" ItemsSource="{Binding BiggestFiles.Kinds}" SelectedItem="{Binding BiggestFiles.Kind}" />
                        <TextBlock Text="{Binding BiggestFiles.Summary}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    </WrapPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="4">
                <DataGrid Style="{StaticResource AppGrid}" ItemsSource="{Binding BiggestFiles.Rows}" SelectedItem="{Binding BiggestFiles.SelectedRow}"
                          ContextMenu="{StaticResource GridNodeMenu}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" MinWidth="0"
                                              ToolTip="{Binding ProtectedReason}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel VerticalAlignment="Center" ToolTip="{Binding Name}">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="4,0,10,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" ElementStyle="{StaticResource NumberCell}" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Type" Binding="{Binding KindName}" SortMemberPath="Kind" Width="110" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=d MMM yyyy}" SortMemberPath="Modified" Width="110" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
