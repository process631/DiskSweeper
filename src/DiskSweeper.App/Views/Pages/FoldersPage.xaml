<UserControl x:Class="DiskSweeper.App.Views.Pages.FoldersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DiskSweeper.App.Views"
             xmlns:vm="clr-namespace:DiskSweeper.App.ViewModels">
    <Grid>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NoScanState}"
                        Visibility="{Binding HasScan, Converter={StaticResource InverseBoolToVisibility}}" />

        <DockPanel Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
            <views:DetailsPanel DockPanel.Dock="Right" Margin="16,0,0,0" />
            <Border Style="{StaticResource Card}" Padding="4">
                <ListView x:Name="TreeList" Style="{StaticResource {x:Static GridView.GridViewStyleKey}}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          ItemsSource="{Binding Tree.Rows}" SelectedItem="{Binding Tree.SelectedRow}" SizeChanged="List_SizeChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="List_Loaded"
                          ItemContainerStyle="{StaticResource TreeRowStyle}" BorderThickness="0" Background="Transparent"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          GridViewColumnHeader.Click="Header_Click" MouseDoubleClick="List_MouseDoubleClick" PreviewKeyDown="List_PreviewKeyDown">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeader}">
                            <GridViewColumn Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanSelect}" MinWidth="0"
                                                  ToolTip="{Binding ProtectedReason}" ToolTipService.ShowOnDisabled="True" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="NameColumn" Width="300">
                                <GridViewColumnHeader Content="Name" Tag="{x:Static vm:TreeSort.Name}" HorizontalContentAlignment="Left" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                            <ToggleButton Width="24" Height="24" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                                          IsChecked="{Binding IsExpanded}" Focusable="False" MinWidth="0" MinHeight="0"
                                                          Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE76C;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE70D;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </ToggleButton>
                                            <Border Width="28" Visibility="{Binding CanExpand, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Tag}" Style="{StaticResource Caption}" Margin="8,0,0,0" FontStyle="Italic" VerticalAlignment="Center"
                                                       Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="96">
                                <GridViewColumnHeader Content="Size" Tag="{x:Static vm:TreeSort.Size}" HorizontalContentAlignment="Right" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" MinWidth="84" TextAlignment="Right" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="140">
                                <GridViewColumnHeader Content="Share" Cursor="Arrow" Padding="18,0,0,0" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="70" Height="6" CornerRadius="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding ShareText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="84">
                                <GridViewColumnHeader Content="Files" Tag="{x:Static vm:TreeSort.Files}" HorizontalContentAlignment="Right" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FilesText}" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100">
                                <GridViewColumnHeader Content="Modified" Tag="{x:Static vm:TreeSort.Modified}" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedText}" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
