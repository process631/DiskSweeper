<UserControl x:Class="DiskSweeper.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,24">

            <TextBlock Text="Scanning" Style="{StaticResource Strong}" Margin="2,0,0,8" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding UseFastScan}" IsEnabled="{Binding IsElevated}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock Text="Fast scan" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Reads the drive's file index directly: a whole drive in a few seconds, and exact sizes even for files that are open. Needs administrator rights; used for whole NTFS drives." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding SaveScans}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock Text="Remember scans" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Keeps the last five scans per drive, so the app opens instantly and the Changes page can show what grew." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Deleting" Style="{StaticResource Strong}" Margin="2,0,0,8" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,16,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Default choice when deleting" />
                            <TextBlock Style="{StaticResource Caption}" Text="You can still pick the other option in the delete dialog each time." TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="32,12,0,0">
                        <RadioButton GroupName="DefaultMethod" IsChecked="{Binding UseRecycleBin}">
                            <TextBlock>
                                <Run Text="Move to the Recycle Bin" /><Run Text="  ·  can be restored; frees space when the bin is emptied" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="DefaultMethod" IsChecked="{Binding UsePermanent}" Margin="0,8,0,0">
                            <TextBlock>
                                <Run Text="Delete permanently" /><Run Text="  ·  frees space right away; can't be undone" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Permissions" Style="{StaticResource Strong}" Margin="2,0,0,8" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource StandardButton}" Command="{Binding RestartAsAdminCommand}" Content="Run as administrator"
                            VerticalAlignment="Center" Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Running as a standard user" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                            <Setter Property="Text" Value="Running as administrator" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Administrator rights allow fast scans and counting folders Windows protects. Fixes that need them (taking ownership, deleting on restart) ask for permission when you use them." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Your data" Style="{StaticResource Strong}" Margin="2,0,0,8" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource StandardButton}" Command="{Binding OpenDataFolderCommand}" Content="Open folder" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock Text="Deletion log, saved scans and settings" />
                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource Strong}" Margin="2,0,0,8" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Image Source="pack://application:,,,/DiskSweeper;component/Assets/Logo.png" Width="36" Height="36" Margin="0,0,16,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel>
                        <TextBlock>
                            <Run Text="DiskSweeper" FontWeight="SemiBold" /><Run Text="  version " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Shows what fills your drives and removes junk safely: Recycle Bin by default, protected Windows folders, every delete logged." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
