<UserControl x:Class="DiskSweeper.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource StandardButton}" Command="{Binding Log.RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE72C;" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StandardButton}" Command="{Binding Log.OpenFileCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8A5;" Margin="0,0,8,0" />
                        <TextBlock Text="Open log file" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Log.FilePath, StringFormat=Also saved to {0}}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="4">
            <DataGrid Style="{StaticResource AppGrid}" ItemsSource="{Binding Log.Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding Time}" Width="150" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="130" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="140" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
