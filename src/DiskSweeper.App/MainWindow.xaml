<Window x:Class="DiskSweeper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DiskSweeper.App.Views"
        xmlns:pages="clr-namespace:DiskSweeper.App.Views.Pages"
        Title="{Binding WindowTitle}" Icon="pack://application:,,,/DiskSweeper;component/Assets/DiskSweeper.ico"
        Width="1380" Height="900" MinWidth="1060" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="14">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Padding="12,18,12,14" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,22">
                    <Image Source="pack://application:,,,/DiskSweeper;component/Assets/Logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DiskSweeper" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Disk space cleaner" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10"
                            Visibility="{Binding Overview.HasDrive, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" />
                                <TextBlock Text="{Binding Overview.DriveTitle}" Style="{StaticResource Strong}" Margin="10,0,0,0" />
                            </StackPanel>
                            <ProgressBar Value="{Binding Overview.DriveUsedPercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,8" />
                            <TextBlock Text="{Binding Overview.DriveFreeText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ScanInfo}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource SubtleButton}" Command="{Binding RestartAsAdminCommand}" HorizontalContentAlignment="Left" Padding="14,8"
                            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}"
                            ToolTip="Restart with administrator rights for fast scans and folders Windows protects.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="Run as administrator" />
                                <TextBlock Text="Faster scans, protected folders" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <ToggleButton Style="{StaticResource NavToggle}" IsChecked="{Binding IsSettingsSelected}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                            <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" CornerRadius="9" Padding="7,1" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page header with scan controls -->
            <DockPanel Margin="32,22,32,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="230" IsEditable="True" ItemsSource="{Binding Drives}" Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Drive or folder to scan" />
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding BrowseCommand}" Margin="4,0,0,0" Padding="9,8" ToolTip="Choose a folder…">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="8,0,0,0" MinWidth="96"
                            Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE721;" Margin="0,0,8,0" />
                            <TextBlock Text="Scan" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StandardButton}" Command="{Binding CancelCommand}" Margin="8,0,0,0" MinWidth="96"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" Content="Cancel" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Notice -->
            <Border Grid.Row="1" Margin="32,0,32,12" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource NoticeBar}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding DismissNoticeCommand}" Padding="6" ToolTip="Dismiss">
                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE711;" />
                    </Button>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Scan / delete progress -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="32,0,32,12" Padding="18,12">
                <Border.Visibility>
                    <MultiBinding Converter="{x:Static views:AnyTrueToVisibilityConverter.Instance}">
                        <Binding Path="IsScanning" />
                        <Binding Path="IsDeleting" />
                    </MultiBinding>
                </Border.Visibility>
                <StackPanel>
                    <TextBlock Text="{Binding ProgressText}" />
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}" Margin="0,10,0,2" />
                </StackPanel>
            </Border>

            <!-- Pages (kept alive so scroll positions and expanded folders survive switching) -->
            <Grid Grid.Row="3" Margin="32,0,32,0">
                <pages:OverviewPage Visibility="{Binding SelectedTab, Converter={x:Static views:EnumVisibilityConverter.Instance}, ConverterParameter=Overview}" />
                <pages:FoldersPage Visibility="{Binding SelectedTab, Converter={x:Static views:EnumVisibilityConverter.Instance}, ConverterParameter=Folders}" />
                <pages:FilesPage Visibility="{Binding SelectedTab, Converter={x:Static views:EnumVisibilityConverter.Instance}, ConverterParameter=Files}" />
                <pages:TreemapPage Visibility="{Binding SelectedTab, Converter={x:Static views:EnumVisibilityConverter.Instance}, ConverterParameter=Treemap}" />
                <pages:TypesPage Visibility="{Binding SelectedTab, Converter={x:Static views:EnumVisibilityConverter.Instance}, ConverterParameter=Types}" />
                <pages:CleanupPage Visibility="{Binding SelectedTab, Converter={x:Static views:EnumVisibilityConverter.Instance}, ConverterParameter=Cleanup}" />
                <pages:ChangesPage Visibility="{Binding SelectedTab, Converter={x:Static views:EnumVisibilityConverter.Instance}, ConverterParameter=Changes}" />
                <pages:HistoryPage Visibility="{Binding SelectedTab, Converter={x:Static views:EnumVisibilityConverter.Instance}, ConverterParameter=History}" />
                <pages:SettingsPage Visibility="{Binding SelectedTab, Converter={x:Static views:EnumVisibilityConverter.Instance}, ConverterParameter=Settings}" />
            </Grid>

            <!-- Selection bar: only while something is ticked -->
            <Border Grid.Row="4" Margin="32,12,32,20" Padding="16,12" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="{Binding Selection.HasItems, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="SelectionToggle" Padding="12,7" Content="View selection" />
                        <Popup IsOpen="{Binding IsChecked, ElementName=SelectionToggle}" PlacementTarget="{Binding ElementName=SelectionToggle}"
                               Placement="Top" VerticalOffset="-8" StaysOpen="False" AllowsTransparency="True">
                            <Border Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Width="480" MaxHeight="420" Padding="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Selection.List}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Grid.Column="3" Style="{StaticResource SubtleButton}" Padding="6" ToolTip="Remove from selection"
                                                            Command="{Binding DataContext.Selection.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE711;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        <Button Style="{StaticResource StandardButton}" Command="{Binding Selection.ClearCommand}" Content="Clear" Margin="8,0,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding DeleteSelectedCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74D;" Margin="0,0,8,0" />
                                <TextBlock Text="Review and delete…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Style="{StaticResource IconTile}" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" HorizontalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Selection.CountText}" Style="{StaticResource Strong}" />
                        <TextBlock Style="{StaticResource Secondary}">
                            <Run Text="{Binding Selection.TotalText, Mode=OneWay}" /><Run Text=" to clean up" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
