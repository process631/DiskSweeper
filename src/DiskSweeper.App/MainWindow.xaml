<Window x:Class="DiskSweeper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DiskSweeper.App.Views"
        xmlns:vm="clr-namespace:DiskSweeper.App.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1320" Height="860" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Shared right-click menu for files and folders. CommandParameter is the row (or node) it was opened on. -->
        <ContextMenu x:Key="NodeMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Select / unselect for deleting" Command="{Binding ToggleSelectCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Show in File Explorer" Command="{Binding ShowInExplorerCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Show in Folders tab" Command="{Binding ShowInFoldersCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Show in Treemap" Command="{Binding ShowInTreemapCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <Style x:Key="TreeRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="FileRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}" />
        </Style>

        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Scan toolbar -->
        <Border DockPanel.Dock="Top" Padding="16,12,16,8">
            <DockPanel LastChildFill="False">
                <ComboBox DockPanel.Dock="Left" Width="320" IsEditable="True" ItemsSource="{Binding Drives}"
                          Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Drive or folder to scan" />
                <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="Browse…" Command="{Binding BrowseCommand}" />
                <Button DockPanel.Dock="Left" Margin="8,0,0,0" MinWidth="90" Command="{Binding ScanCommand}"
                        Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0" />
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelCommand}" />
                <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" Content="Fast scan"
                          IsChecked="{Binding UseFastScan}" IsEnabled="{Binding IsElevated}" ToolTip="{Binding FastScanHint}"
                          ToolTipService.ShowOnDisabled="True" />

                <Button DockPanel.Dock="Right" Command="{Binding RestartAsAdminCommand}"
                        Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}"
                        ToolTip="Restart DiskSweeper with administrator rights: enables fast scanning and counts protected folders.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,8,0" />
                        <TextBlock Text="Run as administrator" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Progress and summary -->
        <Border DockPanel.Dock="Top" Padding="16,0,16,8">
            <StackPanel>
                <ProgressBar Height="4" Margin="0,0,0,6" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Selection bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton GroupName="Method" Content="Recycle Bin" IsChecked="{Binding UseRecycleBin}" VerticalAlignment="Center"
                                 ToolTip="Deleted items can be restored from the Recycle Bin. Space is freed when it's emptied." />
                    <RadioButton GroupName="Method" Content="Delete permanently" IsChecked="{Binding UsePermanent}" VerticalAlignment="Center" Margin="12,0,0,0"
                                 ToolTip="Frees space right away, and handles long paths and odd names. Can't be undone." />
                    <CheckBox Content="Dry run" IsChecked="{Binding DryRun}" VerticalAlignment="Center" Margin="16,0,0,0"
                              ToolTip="Show what would be deleted without deleting anything." />
                    <Button Content="Clear" Command="{Binding Selection.ClearCommand}" Margin="16,0,0,0" />
                    <Button Command="{Binding DeleteSelectedCommand}" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" />
                            <TextBlock Text="Delete selected…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Selection.Summary}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="12,0,12,8" SelectedIndex="{Binding SelectedTab, Converter={x:Static views:EnumIndexConverter.Instance}}">

            <!-- Folders -->
            <TabItem Header="Folders">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="4,0,0,6"
                               Text="Biggest first. Click ▸ or double-click to open a folder, tick to select, right-click for more. Click a column header to sort." />
                    <ListView x:Name="TreeList" ItemsSource="{Binding Tree.Rows}" SelectedItem="{Binding Tree.SelectedRow}"
                              ItemContainerStyle="{StaticResource TreeRowStyle}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              GridViewColumnHeader.Click="TreeHeader_Click" MouseDoubleClick="TreeList_MouseDoubleClick"
                              PreviewKeyDown="TreeList_PreviewKeyDown">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanSelect}"
                                                      ToolTip="{Binding ProtectedReason}" ToolTipService.ShowOnDisabled="True" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="520">
                                    <GridViewColumnHeader Content="Name" Tag="{x:Static vm:TreeSort.Name}" HorizontalContentAlignment="Left" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                                <ToggleButton Width="22" Height="22" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                                              IsChecked="{Binding IsExpanded}" Focusable="False"
                                                              Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE76C;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE70D;" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </ToggleButton>
                                                <Border Width="26" Visibility="{Binding CanExpand, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Tag}" Style="{StaticResource Secondary}" Margin="8,0,0,0" FontStyle="Italic"
                                                           VerticalAlignment="Center" Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="110">
                                    <GridViewColumnHeader Content="Size" Tag="{x:Static vm:TreeSort.Size}" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource RightCell}" FontWeight="SemiBold" MinWidth="90" TextAlignment="Right" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Share of folder" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="120" Height="10" CornerRadius="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                    <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding ShareText}" Margin="8,0,0,0" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="100">
                                    <GridViewColumnHeader Content="Files" Tag="{x:Static vm:TreeSort.Files}" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FilesText}" Style="{StaticResource RightCell}" MinWidth="80" TextAlignment="Right" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="120">
                                    <GridViewColumnHeader Content="Modified" Tag="{x:Static vm:TreeSort.Modified}" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedText}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- Biggest files -->
            <TabItem Header="Biggest files">
                <DockPanel Margin="0,8,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="At least" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="90" Text="{Binding BiggestFiles.MinimumSize, UpdateSourceTrigger=PropertyChanged, Delay=400}" ToolTip="e.g. 500 MB or 2 GB" />
                        <ComboBox Width="220" Margin="12,0,0,0" ItemsSource="{Binding BiggestFiles.AgeChoices}" DisplayMemberPath="Value"
                                  SelectedValuePath="Key" SelectedValue="{Binding BiggestFiles.OlderThanDays}" />
                        <ComboBox Width="150" Margin="12,0,0,0" ItemsSource="{Binding BiggestFiles.Kinds}" SelectedItem="{Binding BiggestFiles.Kind}" />
                        <TextBox Width="220" Margin="12,0,0,0" Text="{Binding BiggestFiles.Search, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                 ToolTip="Part of a file name, or an extension like .iso" />
                        <TextBlock Text="(name or .ext)" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding BiggestFiles.Summary}" Style="{StaticResource Secondary}" Margin="4,0,0,6" />
                    <DataGrid ItemsSource="{Binding BiggestFiles.Rows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowStyle="{StaticResource FileRowStyle}"
                              EnableRowVirtualization="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                                  ToolTip="{Binding ProtectedReason}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Modified" Binding="{Binding Modified, StringFormat=yyyy-MM-dd}" Width="110" />
                            <DataGridTemplateColumn Header="Type" SortMemberPath="Kind" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding KindName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Folder" Binding="{Binding Folder}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- File types -->
            <TabItem Header="File types">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="By kind" FontWeight="SemiBold" Margin="4,0,0,6" />
                        <DataGrid ItemsSource="{Binding FileTypes.Kinds}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Kind" SortMemberPath="Kind" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding KindName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="90" />
                                <DataGridTemplateColumn Header="" Width="*" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Height="10" CornerRadius="3" Width="{Binding BarWidth}"
                                                    Background="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Files" Binding="{Binding Count, StringFormat=N0}" SortMemberPath="Count" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="By extension (double-click to list those files)" FontWeight="SemiBold" Margin="4,0,0,6" />
                        <DataGrid x:Name="ExtensionGrid" ItemsSource="{Binding FileTypes.Extensions}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" MouseDoubleClick="ExtensionGrid_MouseDoubleClick"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Extension" Binding="{Binding Extension}" Width="120" />
                                <DataGridTemplateColumn Header="Kind" SortMemberPath="Kind" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding KindName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="90" />
                                <DataGridTemplateColumn Header="" Width="*" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Height="10" CornerRadius="3" Width="{Binding BarWidth}"
                                                    Background="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Files" Binding="{Binding Count, StringFormat=N0}" SortMemberPath="Count" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Treemap -->
            <TabItem Header="Treemap">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Command="{Binding TreemapUpCommand}" ToolTip="Up one folder">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" />
                        </Button>
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding FileTypes.Kinds}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding KindName}" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Treemap.Breadcrumb}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Treemap.HoverText}" Style="{StaticResource Secondary}" Margin="2,6,0,0" />
                    <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4" ClipToBounds="True">
                        <views:TreemapView x:Name="TreemapControl" Root="{Binding Treemap.Root}" Version="{Binding Treemap.Version}"
                                           HoveredNode="{Binding Treemap.HoveredNode, Mode=OneWayToSource}" NodeActivated="Treemap_NodeActivated"
                                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <views:TreemapView.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Select / unselect for deleting" Command="{Binding ToggleSelectCommand}"
                                              CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Show in File Explorer" Command="{Binding ShowInExplorerCommand}"
                                              CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Show in Folders tab" Command="{Binding ShowInFoldersCommand}"
                                              CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Zoom into this" Command="{Binding ShowInTreemapCommand}"
                                              CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}"
                                              CommandParameter="{Binding PlacementTarget.HoveredNode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </views:TreemapView.ContextMenu>
                        </views:TreemapView>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Smart finds -->
            <TabItem Header="Smart finds">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Command="{Binding FindCommand}" Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE773;" Margin="0,0,8,0" />
                                <TextBlock Text="Find junk and leftovers" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="Select everything marked Safe" Command="{Binding SmartFinds.SelectSafeCommand}" />
                        <Button DockPanel.Dock="Right" Command="{Binding SmartFinds.OpenBcuCommand}"
                                ToolTip="Bulk Crap Uninstaller (free, open source) removes programs together with their registry entries, services and scheduled tasks.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74C;" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SmartFinds.BcuButtonText}" />
                            </StackPanel>
                        </Button>
                        <ProgressBar Width="120" Height="4" IsIndeterminate="True" Margin="12,0" VerticalAlignment="Center"
                                     Visibility="{Binding SmartFinds.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SmartFinds.Status}" TextWrapping="Wrap" Margin="4,0,0,8" />
                    <ListView ItemsSource="{Binding SmartFinds.View}" HorizontalContentAlignment="Stretch"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="4,14,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,0,0"
                                              Visibility="{Binding CanSelect, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Secondary}" />
                                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Tags}" Style="{StaticResource Warning}" Margin="0,2,0,0"
                                                   Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" FontStyle="Italic" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Text="{Binding CommandText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" MinWidth="200" />
                                                <Button Content="Copy" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.SmartFinds.CopyCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding CommandText}" />
                                                <Button Content="Run…" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.SmartFinds.RunAdviceCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding CommandText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <Border Grid.Column="3" Style="{StaticResource Badge}" HorizontalAlignment="Right"
                                            Background="{Binding Badge, Converter={StaticResource BadgeBrush}}">
                                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Show in File Explorer" Command="{Binding ShowInExplorerCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- Changes -->
            <TabItem Header="Changes">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Compare with the scan from" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="380" ItemsSource="{Binding Changes.SavedScans}" SelectedItem="{Binding Changes.Selected}" />
                        <Button Content="Compare" Margin="8,0,0,0" Command="{Binding Changes.CompareCommand}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Changes.Summary}" TextWrapping="Wrap" Margin="4,0,0,8" />
                    <DataGrid ItemsSource="{Binding Changes.Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Change" Binding="{Binding Change}" SortMemberPath="Delta" Width="110" FontWeight="SemiBold" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="What" Binding="{Binding Kind}" Width="80" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Path" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Before" Binding="{Binding Before}" Width="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Now" Binding="{Binding After}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Log -->
            <TabItem Header="Log">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Refresh" Command="{Binding Log.RefreshCommand}" />
                        <Button DockPanel.Dock="Left" Content="Open log file" Margin="8,0,0,0" Command="{Binding Log.OpenFileCommand}" />
                        <TextBlock Text="{Binding Log.FilePath, StringFormat=Every delete attempt is recorded in {0}}" Style="{StaticResource Secondary}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Log.Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Time" Binding="{Binding Time}" Width="150" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Action" Binding="{Binding Action}" Width="120" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Outcome" Binding="{Binding Outcome}" Width="140" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Size" Binding="{Binding Size}" Width="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Path" Binding="{Binding Path}" Width="2*" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Details" Binding="{Binding Details}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
